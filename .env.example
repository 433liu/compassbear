# CompassBear integrated literature RAG + Zotero handoff API keys.
# Copy to .env at the skill root and fill only the providers you want to use.
# Never commit .env to a public repository.

# --- Free providers (no key needed; mailto is a politeness signal) ---

# Crossref polite pool — any working email. Strongly recommended.
CROSSREF_MAILTO=

# OpenAlex polite pool — any working email. Recommended.
OPENALEX_MAILTO=

# Unpaywall — REQUIRED to enable the OA PDF upgrade pass. Any working email.
# Without this, retrieved records won't be enriched with open-access PDF links.
UNPAYWALL_EMAIL=

# --- Free providers with optional API key for higher rate limits ---

# Semantic Scholar — works without a key but rate-limited (~1 req/sec).
# Request a key at https://www.semanticscholar.org/product/api for sustained use.
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex — also works without a key. API key gives higher rate limits.
OPENALEX_API_KEY=

# --- Paid providers (optional) ---

# Serper.dev — Google-search wrapper, paid. Useful as a fallback only.
SERPER_API_KEY=

# Lens.org — patent + scholarly. Free tier exists but limited.
# (Reserved for future provider wiring; not used by literature_rag.py yet.)
LENS_API_KEY=

# --- Zotero handoff (used by scripts/zotero_sync.py) ---
#
# Free API key from https://www.zotero.org/settings/keys
# Your numeric user ID is shown on the same page (e.g. 1234567).
#
# After running literature_rag.py you can push results into Zotero with:
#   python scripts/zotero_sync.py push --from-json outputs/literature-rag/evidence_matrix.json
# Read and tag in Zotero, then pull back as source-pack stubs with:
#   python scripts/zotero_sync.py pull --out-dir private/source-packs/from-zotero
#
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_LIBRARY_TYPE=users
# Optional: narrow push/pull to a single collection. Find the collection key
# in the URL when you click the collection in https://www.zotero.org/...
ZOTERO_COLLECTION_KEY=

# Local Zotero read-only helper (`scripts/zotero_local_read.py`).
# Defaults to ~/Zotero, which is C:\Users\<you>\Zotero on Windows.
# Set this only if your Zotero data directory lives elsewhere.
ZOTERO_DATA_DIR=

# --- Institutional / paid academic databases ---
#
# Web of Science, Scopus, ScienceDirect, ACS, Wiley, Springer Nature etc. are
# IP-gated browser subscriptions by default. The browser access your university
# provides CANNOT be plugged into this script.
#
# What CAN be plugged in: separate institutional API agreements such as
#   - WoS Starter API / WoS Expanded API (Clarivate)
#   - Scopus API (Elsevier)
#   - ScienceDirect / Elsevier TDM API
#   - Wiley TDM API
#
# Your library may or may not have these — most institutions only have the
# browser subscription. Ask the reference desk specifically about "API access"
# or "Text and Data Mining (TDM) agreement", and request an institutional API
# key if one exists. If you obtain one, add a search_* function in
# scripts/literature_rag.py mirroring the existing providers.
#
# Note: even with an institutional API key, scripted bulk download of paywalled
# full text is typically restricted by the TDM license; respect rate limits and
# the institution's terms.
